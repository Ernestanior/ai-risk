# DeepSeek API 配置（key 只在服务端使用，不会暴露给浏览器）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 输入上下文字符上限（约 1.5 字符≈1 token，DeepSeek 上限约 6.4 万 token）
# 参考资料优先全量，项目资料超出部分会被截断
MAX_INPUT_CHARS=90000

# ===== 视觉模型（OCR 扫描件用）=====
# 智谱 GLM-4V。去 https://open.bigmodel.cn 注册拿 key
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
VISION_MODEL=glm-4v-plus
