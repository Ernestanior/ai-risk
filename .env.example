# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 输入上下文字符上限（约 1.5 字符≈1 token，DeepSeek 上限约 6.4 万 token）
# 参考资料优先全量，项目资料超出部分会被截断
MAX_INPUT_CHARS=90000

# 智谱 AI 视觉模型（OCR 扫描件用）
# 去 https://open.bigmodel.cn 注册获取 API Key
VISION_API_KEY=your_vision_api_key_here

# 阿里通义千问 VL 视觉模型（可选，推荐用于表格识别）
# 获取方式：https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=your_qwen_api_key_here
